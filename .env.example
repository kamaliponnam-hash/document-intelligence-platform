# Copy this file to .env and fill in real values. Never commit a real .env file.

# --- General ---
APP_NAME=Document Intelligence Platform
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- Database ---
# Default: local SQLite file (zero-config, good for free-tier deployment).
# For Postgres/MySQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./storage/document_intelligence.db
UPLOAD_DIR=./storage/uploads

# --- Upload constraints ---
MAX_PAGE_COUNT=3
MAX_FILE_SIZE_MB=15

# --- OCR ---
NATIVE_TEXT_MIN_CHARS=20
OCR_DPI=300
TESSERACT_LANG=eng
# Only needed if tesseract is not on PATH:
# TESSERACT_CMD=/usr/bin/tesseract

# --- LLM extraction ---
# Supported providers: "gemini" (Google AI Studio, free tier — recommended
# for this assignment) or "anthropic" (Claude, requires paid API credits).
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey (no billing required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
# If true, the app falls back to a lightweight offline regex extractor when
# no API key is set or the LLM call fails, instead of returning a 5xx error.
ALLOW_OFFLINE_EXTRACTION_FALLBACK=true

# --- Financial validation tolerance ---
VALIDATION_ABS_TOLERANCE=1.0
VALIDATION_REL_TOLERANCE_PERCENT=1.0
